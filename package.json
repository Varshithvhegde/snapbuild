{
  "name": "snapbuild",
  "private": true,
  "version": "0.1.0",
  "description": "AI-powered mobile website builder — build, edit, deploy, and share",
  "scripts": {
    "dev": "npm-run-all --parallel dev:web dev:convex",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:convex": "rm -rf convex/node_modules && npx convex dev",
    "convex:push": "rm -rf convex/node_modules && npx convex dev --once",
    "build": "npm run build --workspace=apps/web",
    "deploy:worker": "cd worker && wrangler deploy",
    "seed": "npx convex run seed:seedTemplates",
    "setup:convex": "bash scripts/setup-convex.sh",
    "typecheck": "npm run typecheck --workspace=apps/web"
  },
  "workspaces": [
    "apps/web",
    "convex"
  ],
  "devDependencies": {
    "convex": "^1.21.0",
    "esbuild": "^0.25.9",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20"
  }
}
